          },
          "outlook_wxs_bolt": {
            "sources": "images/outlook_wxs_bolt.png",
            "color_format": "CF_TRUE_COLOR_ALPHA"
          },
          "outlook_wxs_snow": {
            "sources": "images/outlook_wxs_snow.png",
            "color_format": "CF_TRUE_COLOR_ALPHA"
          },
          "outlook_wxs_smog": {
            "sources": "images/outlook_wxs_smog.png",
            "color_format": "CF_TRUE_COLOR_ALPHA"
          },
          "outlook_wxs_unknown": {
            "sources": "images/outlook_wxs_unknown.png",
            "color_format": "CF_TRUE_COLOR_ALPHA"
          }
        }
      }
    },
    {
      "type": "watchface",
      "enum": "Glow",
      "name": "Glow",
      "description": "Minimal analog: cyan hands, a red second hand, the date, battery and Bluetooth.",
      "header": "glow/WatchFaceGlow.h",
      "sources": [
        "glow/WatchFaceGlow.cpp"
      ],
      "resources": {
        "fonts": {
          "glow_text": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-SemiBold.ttf",
                "symbols": " 0123456789ABCDEFGHIJLMNOPRSTUVWY"
              }
            ],
            "size": 15,
            "bpp": 2
          }
        }
      }
    },
    {
      "type": "watchface",
      "enum": "Noir",
      "name": "Noir",
      "description": "Long white hands and a red second hand on black, with the date at three.",
      "header": "noir/WatchFaceNoir.h",
      "sources": [
        "noir/WatchFaceNoir.cpp"
      ],
      "resources": {
        "fonts": {
          "noir_text": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-Medium.ttf",
                "symbols": " 0123456789ADEFHIMNORSTUW"
              }
            ],
            "size": 16,
            "bpp": 2
          }
        }
      }
    },
    {
      "type": "watchface",
      "enum": "Subdial",
      "name": "Subdial",
      "description": "A dress-watch face with a small-seconds sub-dial, date window and weekday.",
      "header": "subdial/WatchFaceSubdial.h",
      "sources": [
        "subdial/WatchFaceSubdial.cpp"
      ],
      "resources": {
        "fonts": {
          "subdial_text": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-Medium.ttf",
                "symbols": " 0123456789FMSTWadehinorstuy"
              }
            ],
            "size": 18,
            "bpp": 2
          }
        }
      }
    },
    {
      "type": "watchface",
      "enum": "Constellation",
      "name": "Constellation",
      "description": "The hour and minute as stars joined like a constellation, on a starry sky, with the weather and date.",
      "header": "constellation/WatchFaceConstellation.h",
      "sources": [
        "constellation/WatchFaceConstellation.cpp"
      ],
      "resources": {
        "fonts": {
          "constellation_text": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-Medium.ttf",
                "symbols": " -0123456789ABCDEFGHIJLMNOPRSTUVWYadeghilmnorstuwy°"
              }
            ],
            "size": 22,
            "bpp": 2
          }
        },
        "images": {
          "constellation_stars": {
            "sources": "images/constellation_stars.png",
            "color_format": "CF_INDEXED_1_BIT"
          }
        }
      }
    },
    {
      "type": "watchface",
      "enum": "Almanac",
      "name": "Almanac",
      "description": "The time as two rulers, hours above and minutes below, with the weather and date.",
      "header": "almanac/WatchFaceAlmanac.h",
      "sources": [
        "almanac/WatchFaceAlmanac.cpp"
      ],
      "resources": {
        "fonts": {
          "almanac_hour": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-Light.ttf",
                "symbols": "0123456789"
              }
            ],
            "size": 46,
            "bpp": 2
          },
          "almanac_minute": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-Light.ttf",
                "symbols": "0123456789"
              }
            ],
            "size": 38,
            "bpp": 2
          },
          "almanac_mid": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-Light.ttf",
                "symbols": "0123456789 "
              }
            ],
            "size": 26,
            "bpp": 2
          },
          "almanac_small": {
            "sources": [
              {
                "file": "fonts/BarlowCondensed-Medium.ttf",
                "symbols": " -0123456789ACDFJMNOSTWabcdeghilnoprtuvy°"
              }
            ],
            "size": 19,
            "bpp": 2
          }
        }
      }
