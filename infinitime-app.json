          },
          "outlook_wxs_cloud": {
            "sources": "images/outlook_wxs_cloud.png",
            "color_format": "CF_TRUE_COLOR_ALPHA"
          },
          "outlook_wxs_brokenclouds": {
            "sources": "images/outlook_wxs_brokenclouds.png",
            "color_format": "CF_TRUE_COLOR_ALPHA"
          },
          "outlook_wxs_showers": {
            "sources": "images/outlook_wxs_showers.png",
